rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // devicesコレクション: サーバー側（Cloud Functions）からのみアクセス可能
    match /devices/{deviceId} {
      allow read, write: if false;
    }
    
    // その他のドキュメント: すべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
